# SPDX-License-Identifier: Apache-2.0
on early-init
    # Keep platform SurfaceFlinger budgets until RK3399 measurements exist.
    # Register the AIDL software Codec2 store before media services start.
    setprop media.c2.hal.selection aidl
    setprop debug.stagefright.ccodec 4
    # Use memfd shared memory; this kernel has no legacy ashmem device.
    setprop sys.use_memfd true

on init
    # The board has no battery. Keep mains-powered HDMI bring-up awake.
    write /sys/power/wake_lock firefly_bringup
    # Kernel zram compression is selected before swapon_all sets its size.
    write /sys/block/zram0/comp_algorithm lz4
    # Root init mounts configfs before this imported on-init action runs.
    # The common USB rc only binds these objects after adbd opens FunctionFS.
    mkdir /config/usb_gadget/g1 0770 root root
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/bcdDevice 0x0100
    mkdir /config/usb_gadget/g1/strings/0x409 0770 root root
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer Firefly
    write /config/usb_gadget/g1/strings/0x409/product Firefly-RK3399
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000
    start firefly-usb-controller
    setprop sys.usb.configfs 1

# The common USB action does not listen for a controller discovered after
# FunctionFS is ready. Complete that binding without restarting adbd.
on property:vendor.firefly.usb.controller.ready=1 && property:sys.usb.controller=* && property:sys.usb.config=adb && property:sys.usb.configfs=1 && property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on fs
    mount_all /vendor/etc/fstab.fireflyrk3399 --early

on late-fs
    mount_all /vendor/etc/fstab.fireflyrk3399 --late

on post-fs-data
    mkdir /data/vendor/firefly 0770 system system
    # Logs can be collected with authenticated USB adb after boot.
    # The port's adbd patch also suppresses the USB-failure network fallback.
    swapon_all /vendor/etc/fstab.fireflyrk3399


# Select the actual registered internal USB0 device controller by hardware path.
service firefly-usb-controller /system/bin/sh /vendor/bin/firefly-usb-controller.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:vendor_init:s0
