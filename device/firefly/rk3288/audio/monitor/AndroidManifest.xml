<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.firefly.audio" android:sharedUserId="android.uid.system">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="37" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:name=".HdmiAudioApplication" android:label="Firefly HDMI Audio"
        android:allowBackup="false" android:persistent="true" android:directBootAware="true">
        <service android:name=".HdmiAudioService" android:exported="false" />
        <receiver android:name=".HdmiAudioBootReceiver" android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
