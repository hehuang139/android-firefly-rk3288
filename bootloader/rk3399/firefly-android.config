# Original Firefly-RK3399 DDR3. No persistent environment read/write.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_VIDEO is not set
# CONFIG_DISPLAY_ROCKCHIP_HDMI is not set
# CONFIG_SILENT_CONSOLE is not set
CONFIG_CMD_BOOTI=y
CONFIG_BOOTDELAY=2
CONFIG_BAUDRATE=1500000
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3399-firefly-android.dtb"
CONFIG_BOOTSTD_FULL=y
CONFIG_CMD_BOOTFLOW_FULL=y
CONFIG_BOOTCOMMAND="bootflow scan -lbG mmc0"
