# Compatibility controllers and networking used by Android task_profiles/netd.
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG_V1=y
CONFIG_NET_SCHED=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
# CONFIG_TRUSTED_KEYS is not set

# Android SystemSuspend wake-lock interface and interactive scheduling.
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0
CONFIG_PM_WAKELOCKS_GC=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PREEMPT=y
CONFIG_HZ_250=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y

# Preserve the reboot target in RK3288 PMU sys_reg3 for U-Boot USB Fastboot.
CONFIG_SYSCON_REBOOT_MODE=y
