+}
+
+// Configure only the real, named ES8323 controls. Missing controls fail the
+// stream instead of silently discarding audio or using another ALSA card.
+bool configureAnalogMixer(int card) {
+    std::unique_ptr<mixer, decltype(&mixer_close)> mix(mixer_open(card), mixer_close);
+    if (!mix) return false;
+    const auto set = [&](const char* name, int value) {
+        mixer_ctl* ctl = mixer_get_ctl_by_name(mix.get(), name);
+        if (!ctl) { LOG(ERROR) << "Missing ES8323 control " << name; return false; }
+        for (unsigned i = 0; i < mixer_ctl_get_num_values(ctl); ++i) {
+            if (mixer_ctl_set_value(ctl, i, value) != 0) {
+                LOG(ERROR) << "Failed ES8323 control " << name; return false;
+            }
+        }
+        return true;
+    };
+    // PCM 192 = 0 dB; output 2 at 21 = -13.5 dB. Output 1 is unused.
+    // Android supplies user volume/mute. Headphones Switch is the DT route.
+    return set("Left Mixer Left Bypass Switch", 0) &&
+           set("Right Mixer Right Bypass Switch", 0) &&
+           set("PCM Volume", 192) &&
+           set("Output 1 Playback Volume", 0) &&
+           set("Output 2 Playback Volume", 21) &&
+           set("Headphones Switch", 1) &&
+           set("Left Mixer Left Playback Switch", 1) &&
+           set("Right Mixer Right Playback Switch", 1);
 }
 
