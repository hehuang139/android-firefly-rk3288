+// This userdebug port runs a native ARM32 kernel and userspace. Its ARM JIT
+// lacks atomic operations and BPF subprogram calls. Keep all verifier/load/map
+// checks, but permit the kernel's real interpreter for this exact board only.
+// This requires CONFIG_BPF_JIT_ALWAYS_ON=n; it does not mark loading successful.
+static bool fireflyArm32BpfCompat() {
+#if defined(__arm__) && !defined(__aarch64__)
+    static const bool enabled = isArm() && isKernel32Bit() && isUserdebug &&
+            GetProperty("ro.hardware", "") == "fireflyrk3288" &&
+            GetProperty("ro.product.device", "") == "rk3288";
+    return enabled;
+#else
+    return false;
+#endif
+}
